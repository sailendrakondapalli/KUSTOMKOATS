# Supabase Edge Functions Environment Variables
# Copy this file to supabase/.env and fill in your values

# Razorpay credentials for Edge Functions
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_secret_key_here

# Razorpay Webhook Secret (get from Razorpay Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# These are automatically provided by Supabase locally:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY
